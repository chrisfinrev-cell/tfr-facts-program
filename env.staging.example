# =============================================================================
# tfr-facts-program — STAGING / BETA environment template
# Copy to .env.staging (gitignored). Use a SEPARATE Neon branch/project.
# =============================================================================

NODE_ENV=staging

# Isolated staging database (do NOT point at production Neon)
DATABASE_URL=postgresql://USER:PASSWORD@ep-STAGING-HOST.neon.tech/neondb?sslmode=require

# Session (min 32 chars; unique per environment)
SESSION_SECRET=replace-with-a-long-random-staging-secret-32+

# Beta gates
REQUIRE_BETA_NDA=true
BETA_MODE=true
# Comma-separated modules to force-disable in beta (optional)
BETA_DISABLED_MODULES=mod_lending_desk,mod_sweep

# Twilio Verify — prefer a dedicated Verify service for staging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_ID=

# Stripe — TEST mode keys + payment links only
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_INDIVIDUAL_MONTHLY_LINK=
STRIPE_INDIVIDUAL_ANNUAL_LINK=
STRIPE_TFR_PRO_MONTHLY_LINK=
STRIPE_TFR_PRO_ANNUAL_LINK=

# Plaid — sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# OpenAI — leave blank to disable AI features in beta
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Seed / sandbox passwords (do not commit real values)
SANDBOX_PASSWORD=
BETA_SEED_PASSWORD=
EXEMPT_ACCOUNT_TEMP_PASSWORD=

# Ops / monitoring (optional)
SENTRY_DSN=
LOG_LEVEL=info
PUBLIC_APP_URL=https://staging.example.com

# Next.js web beta also needs web/.env.local:
# API_PROXY_URL=http://localhost:3000
# DATABASE_URL=<same staging Neon URL>
