# Browser-facing API origin. Leave blank to use same-origin Next rewrites to Express.
NEXT_PUBLIC_API_URL=

# Server-side rewrite target for Express APIs
API_PROXY_URL=http://localhost:3000

# Used by Next.js NDA PDF route and web/scripts/seed-nda-user.ts (server-side only)
# Copy to web/.env.local and replace the bracketed values from the Neon console:
# DATABASE_URL="postgresql://[user]:[password]@[ep-host].neon.tech/neondb?sslmode=require"
DATABASE_URL=
